# PostgreSQL / Neon pooled connection string
DATABASE_URL=postgresql://stateflow:stateflow@localhost:5432/stateflow

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StateFlow

# Closed by default. Accounts are normally created by an administrator.
PUBLIC_REGISTRATION=false
DEMO_MODE=true
